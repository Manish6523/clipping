# ==========================================
# AutoClipDaemon Environment Configuration
# ==========================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
ADMIN_CHAT_ID=123456789

# Google Gemini API
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# Twitch API & IRC Credentials (Optional for Public Live Streams / Anonymous Chat)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Hardware Acceleration Configuration
# Set to true on Linux systems with VAAPI-compatible Intel/AMD GPU
USE_VAAPI=false
VAAPI_DEVICE="/dev/dri/renderD128"

# Video Processing & Detection Thresholds
DEFAULT_MIN_VIRALITY_SCORE=70
CHAT_SPIKE_MULTIPLIER=2.5
AUDIO_PEAK_DB_THRESHOLD=-6.0

# Drip Queue Scheduling
DRIP_INTERVAL_HOURS=4

# Paths Configuration (Overrides default relative directories if set)
# DATA_DIR="/var/lib/autoclip/data"
# BUFFER_DIR="/tmp/live_buffer"
# RENDER_DIR="/tmp/renders"

