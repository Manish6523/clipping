    "teaser_duration_sec": 1.5,
    "teaser_transition": "flash"
  },
  "anti_shadowban": {
    "speed_multiplier": 1.02,
    "contrast": 1.03,
    "saturation": 1.04,
    "watermark_path": null,
    "watermark_position": "top_right",
    "watermark_opacity": 0.85,
    "bg_tension_audio": null,
    "bg_tension_db": -26.0
  },
  "destinations": {
