{
  "name": "podcast_split",
  "description": "50/50 dual speaker split-screen with centered clean captions and subtle contrast enhancement",
  "min_virality_score": 70,
  "chat_spike_multiplier": 2.0,
  "hype_keywords": [
    "DAMN",
    "REAL",
    "FACTS",
    "WTF",
    "TRUE",
    "WOW",
    "DEEP",
    "CLIP THIS"
  ],
  "layout": {
    "schema": 2,
    "type": "split_screen_50_50",
    "canvas": {
      "w": 1080,
      "h": 1920
    },
    "background": {
      "type": "solid",
      "source_layer": null,
      "blur": 0,
      "dim": 0.0,
      "color": "#000000"
    },
    "layers": [
      {
        "id": "l_top",
        "name": "Speaker 1 (Top)",
        "color": "#FFB020",
        "visible": true,
        "locked": false,
        "src": {
          "x": 0.0,
          "y": 0.0,
          "w": 0.5,
          "h": 1.0
        },
        "dst": {
          "x": 0.0,
          "y": 0.0,
          "w": 1.0,
          "h": 0.5
        },
        "fit": "cover",
        "aspect_lock": true,
        "style": {
          "radius": 0.0,
          "shape": "rect",
          "border": {
            "w": 0,
            "color": "#FFFFFF"
          },
          "shadow": {
            "blur": 0,
            "opacity": 0.0,
            "dx": 0,
            "dy": 0
          },
          "opacity": 1.0,
          "mirror": false
        },
        "tracking": {
          "mode": "off",
          "smooth": 0.8
        },
        "keyframes": {
          "src": [],
          "dst": []
        },
        "visible_range": null
      },
      {
        "id": "l_bot",
        "name": "Speaker 2 (Bottom)",
        "color": "#00F0FF",
        "visible": true,
        "locked": false,
        "src": {
          "x": 0.5,
          "y": 0.0,
          "w": 0.5,
          "h": 1.0
        },
        "dst": {
          "x": 0.0,
          "y": 0.5,
          "w": 1.0,
          "h": 0.5
        },
        "fit": "cover",
        "aspect_lock": true,
        "style": {
          "radius": 0.0,
          "shape": "rect",
          "border": {
            "w": 0,
            "color": "#FFFFFF"
          },
          "shadow": {
            "blur": 0,
            "opacity": 0.0,
            "dx": 0,
            "dy": 0
          },
          "opacity": 1.0,
          "mirror": false
        },
        "tracking": {
          "mode": "off",
          "smooth": 0.8
        },
        "keyframes": {
          "src": [],
          "dst": []
        },
        "visible_range": null
      }
    ],
    "top_crop": {
      "name": "speaker_one",
      "source_x": 0,
      "source_y": 0,
      "source_w": 960,
      "source_h": 1080,
      "target_w": 1080,
      "target_h": 960
    },
    "bottom_crop": {
      "name": "speaker_two",
      "source_x": 960,
      "source_y": 0,
      "source_w": 960,
      "source_h": 1080,
      "target_w": 1080,
      "target_h": 960
    }
  },
  "subtitles": {
    "font_name": "TheBoldFont",
    "font_size": 68,
    "primary_color": "&H00FFFFFF",
    "highlight_color": "&H0000D0FF",
    "outline_color": "&H00000000",
    "back_color": "&H80000000",
    "bold": true,
    "italic": false,
    "outline": 3.5,
    "shadow": 1.5,
    "margin_v": 960,
    "alignment": 2,
    "max_words_per_screen": 3,
    "animation_tag": "{\\t(0,60,\\fscx112\\fscy112)}"
  },
  "pacing": {
    "strip_silences": true,
    "silence_threshold_ms": 400,
    "silence_noise_db": -38.0,
    "teaser_preroll": false,
    "teaser_duration_sec": 1.5,
    "teaser_transition": "none"
  },
  "anti_shadowban": {
    "speed_multiplier": 1.01,
    "contrast": 1.02,
    "saturation": 1.03,
    "watermark_path": "assets/watermarks/podcast_logo.png",
    "watermark_position": "top_center",
    "watermark_opacity": 0.8,
    "bg_tension_audio": null,
    "bg_tension_db": -28.0
  },
  "destinations": {
    "youtube_account_key": "podcast_yt",
    "instagram_account_key": "podcast_ig"
  }
}